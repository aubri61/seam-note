# Local Vite proxy reads shell environment (example: SEAM_NOTE_API_TARGET=... pnpm dev).
# This file documents names; copying it alone does not export shell variables.
# No production VITE_* secrets or API credentials.
SEAM_NOTE_API_TARGET=http://127.0.0.1:18765
# Vercel server function only (set in Vercel project environment, not client):
# API_PUBLIC_URL=https://api.example.com
# FRONTEND_ORIGIN=https://your-project.vercel.app
