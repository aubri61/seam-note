# Copy to backend/.env.local. python3 run-local.py loads this file.
# Leave the JWT key empty for the local runner to generate and persist one.
AUTH_JWT_SECRET_BASE64=
AUTH_JWT_ISSUER=urn:seam-note:local
AUTH_JWT_AUDIENCE=seam-note-local-api
AUTH_JWT_ACCESS_TTL_SECONDS=300
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/oauth2/callback/google
# Optional: both values are required to enable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
