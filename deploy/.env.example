# Copy to deploy/.env on EC2; chmod 600. Never commit real values.
# Use single quotes for literal passwords/hashes containing $ or #.
BACKEND_IMAGE=seam-note-backend:REPLACE_WITH_GIT_SHA
DB_HOST=REPLACE_FROM_SUPABASE_CONNECT
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=REPLACE_FROM_SUPABASE_CONNECT
DB_PASSWORD='REPLACE_LOCALLY'
AUTH_JWT_SECRET_BASE64='GENERATE_AND_SET_LOCALLY_AT_LEAST_32_RANDOM_BYTES_BASE64'
AUTH_JWT_ISSUER=urn:seam-note:production
AUTH_JWT_AUDIENCE=seam-note-production-api
SPRING_PROFILES_ACTIVE=prod
API_HOST=api.example.com
FRONTEND_ORIGIN=https://your-project.vercel.app
ACME_EMAIL=operator@example.com
VALIDATION_USERNAME=reviewer
VALIDATION_PASSWORD_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'

# Direct Connection: true on an IPv6-capable Docker host; Session Pooler: false.
ENABLE_IPV6=false

# Authentication transition: select only after local/HTTPS checks and coordinated frontend deployment.
# Vercel server env: PROXY_AUTH_MODE=jwt (default stays basic).
# CADDY_CONFIG=./Caddyfile.jwt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-project.vercel.app/api/auth/oauth2/callback/google
